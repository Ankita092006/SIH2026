# Backend Environment Configuration Template
# COPY THIS FILE TO .env AND SET SECURE VALUES FOR YOUR ENVIRONMENT
# NEVER COMMIT REAL SECRETS, TOKENS, OR CREDENTIALS TO GIT

PORT=5000
NODE_ENV=development

# MySQL Database (Aiven / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=sih26003_db

# JWT Security
# In production, JWT_SECRET must be set to a cryptographically strong random string (>= 32 chars)
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_here
JWT_EXPIRES_IN=24h

# Internal Service URLs (Not exposed to frontend)
ML_ADAPTIVE_URL=http://127.0.0.1:8000
VOICE_API_URL=https://soumya9679-sih26003-voice-asr.hf.space
HF_TOKEN=your_huggingface_token_if_needed

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5173
