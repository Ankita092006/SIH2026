# ============================================================
# SIH26003 Backend Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit your actual .env file to source control.
# ============================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# MySQL / Aiven Database Connection Parameters
# (All parameters are REQUIRED. The backend will fail to start if any are missing)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=21048
DB_USER=avnadmin
DB_PASSWORD=your_secure_db_password
DB_NAME=defaultdb

# JWT Authentication Configuration
# (JWT_SECRET is REQUIRED and must be at least 16 characters long)
JWT_SECRET=your_jwt_secret_key_minimum_16_characters_long
JWT_EXPIRES_IN=7d

# Internal Python ML Microservices Gateway URLs
ML_ADAPTIVE_URL=http://localhost:8000
ML_VOICE_URL=http://localhost:8001
