# Frontend Safe Public Environment Variables
# NEVER place DB credentials, JWT secrets, or ML keys here.

# Node.js API Gateway URL (when real backend is running)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to true to use the built-in isolated mock API adapter (default for isolated dev/test)
# Set to false to proxy requests directly to VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Optional Google OAuth Client ID for elderly caregiver sign-in
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
